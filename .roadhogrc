{
  "entry": "src/index.js",
  "disableCSSModules":true,
  "publicPath": "./", // 相对路径：同一份产物在 /deepviz/、/Deep-Viz-Website/ 或根路径下都能用
  "env": {
    "development": {
      "extraBabelPlugins": [
        "dva-hmr",
        ["transform-runtime", {"helpers": false,
          "polyfill": false,
          "regenerator": true}],
        ["import", { "libraryName": "antd", "style": "css" }]
      ]
    },
    "production": {
      "extraBabelPlugins": [
        ["transform-runtime", {"helpers": false,
          "polyfill": false,
          "regenerator": true}],
        ["import", { "libraryName": "antd", "style": "css" }]
      ]
    }
  }
}
